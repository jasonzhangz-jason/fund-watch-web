{
  "name": "fund-watch-web",
  "private": true,
  "version": "2.0.0",
  "description": "基金助手：React 前端（复刻 11 张截图 UI）+ Node 后端（天天基金数据代理 / 账号 / SQLite 自选 / 后台管理）。注：不设 \"type\": \"module\" —— 后端 api/*.js 为 CommonJS；ESM 侧一律使用 .mjs/.mts 显式扩展名。",
  "scripts": {
    "start": "node scripts/dev/dev-all.mjs",
    "dev:all": "node scripts/dev/dev-all.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "shoot": "node scripts/media/shoot.mjs",
    "dev:api": "node --disable-warning=ExperimentalWarning scripts/dev/dev-server.mjs",
    "dev:api:watch": "node --watch --disable-warning=ExperimentalWarning scripts/dev/dev-server.mjs",
    "dev:api:open": "node --disable-warning=ExperimentalWarning scripts/dev/dev-server.mjs --open",
    "dev:api:no-qr": "node --disable-warning=ExperimentalWarning scripts/dev/dev-server.mjs --no-qr",
    "deploy": "vercel deploy --prod",
    "db:info": "node --disable-warning=ExperimentalWarning scripts/data/db-tool.mjs info",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/data/db-tool.mjs backup",
    "db:checkpoint": "node --disable-warning=ExperimentalWarning scripts/data/db-tool.mjs checkpoint",
    "cf:dev": "wrangler dev --config backend/workers/wrangler.toml",
    "cf:deploy": "wrangler deploy --config backend/workers/wrangler.toml",
    "cf:db:create": "wrangler d1 create fund-watch",
    "cf:db:migrate": "wrangler d1 migrations apply fund-watch --remote --config backend/workers/wrangler.toml",
    "cf:db:migrate:local": "wrangler d1 migrations apply fund-watch --local --config backend/workers/wrangler.toml",
    "cf:pages": "wrangler pages deploy dist --project-name fund-watch --branch main",
    "cf:pages:preview": "wrangler pages deploy dist --project-name fund-watch --branch fund-watch-v2",
    "cf:check": "node scripts/deploy/cf-preflight.mjs",
    "cf:doctor": "node scripts/deploy/cf-doctor.mjs",
    "d1:export": "node --disable-warning=ExperimentalWarning scripts/deploy/d1-export.mjs",
    "test:api": "node scripts/tests/test-api.mjs",
    "test:live": "node scripts/tests/test-live-ui.cjs",
    "test:workers": "node scripts/tests/test-workers.mjs",
    "test:portfolio": "node scripts/tests/test-portfolio.mjs",
    "test:correlation": "node scripts/tests/test-correlation.mjs",
    "test:docs": "node scripts/tests/test-docs.mjs",
    "test:overflow": "node scripts/tests/check-overflow.cjs",
    "test:persistence": "node scripts/tests/test-persistence.mjs",
    "test:auth": "node scripts/tests/test-auth.mjs",
    "test:admin": "node scripts/tests/test-admin.mjs",
    "test:qr": "node scripts/tests/qr-verify.mjs",
    "test:qr:decode": "node scripts/tests/qr-decode-test.cjs",
    "test:qr:e2e": "node scripts/tests/qr-e2e-test.cjs",
    "test:legacy:e2e": "node scripts/tests/smoke-test.cjs",
    "test:legacy:auth-ui": "node scripts/tests/smoke-auth-ui.cjs",
    "test:legacy:admin-ui": "node scripts/tests/smoke-admin-ui.cjs",
    "test:legacy:mobile": "node scripts/tests/smoke-mobile.cjs",
    "test:legacy:responsive": "node scripts/tests/smoke-responsive.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
