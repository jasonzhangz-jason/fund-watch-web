.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #eceff4;
  margin-bottom: 24rpx;
}
.empty-title { font-size: 28rpx; color: var(--ink-2); }
.empty-desc { margin-top: 12rpx; font-size: 24rpx; color: var(--ink-3); line-height: 1.6; }
.empty-btn {
  margin-top: 32rpx;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
