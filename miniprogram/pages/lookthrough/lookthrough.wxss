.page { min-height: 100vh; background: var(--page-bg); }
.top-pad { padding-top: 18rpx; }
.amount { margin-top: 10rpx; }
.right { align-items: flex-end; }
.coverage { margin-top: 26rpx; }
.bar { height: 12rpx; background: #eff1f4; border-radius: 6rpx; margin-top: 12rpx; overflow: hidden; }
.bar-in { height: 12rpx; background: var(--primary); border-radius: 6rpx; }
.note { margin-top: 16rpx; line-height: 1.6; }
.refresh { margin-top: 24rpx; }
.sort-bar { display: flex; align-items: center; padding: 20rpx 30rpx 6rpx; }
.chip { margin-left: 16rpx; padding: 6rpx 20rpx; border-radius: 30rpx; font-size: 24rpx; color: var(--ink-2); background: #fff; }
.chip.on { background: var(--primary-tint); color: var(--primary); font-weight: 600; }
.list { background: #fff; margin-top: 12rpx; }
.rank { width: 40rpx; }
.sub { margin-top: 6rpx; }
.arrow { margin-left: 12rpx; color: var(--ink-3); font-size: 26rpx; }
.funds { background: var(--page-bg); padding: 12rpx 30rpx 20rpx; }
.fund-row { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-top: 12rpx; }
.funds-note { margin-top: 14rpx; }
.err, .empty-tip { padding: 24rpx 30rpx; }
.tags { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.tag-item { background: var(--field); border-radius: 30rpx; padding: 6rpx 20rpx; font-size: 22rpx; color: var(--ink-2); margin: 0 12rpx 12rpx 0; }
.bottom-space { height: 60rpx; }
