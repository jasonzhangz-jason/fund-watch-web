.page { min-height: 100vh; background: var(--page-bg); }
.top-pad { padding-top: 18rpx; }
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--primary);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 24rpx;
}
.avatar-off { background: #eceff4; color: var(--ink-3); }
.role-line { margin-top: 6rpx; }
.tabs { display: flex; margin: 30rpx 0 10rpx; background: var(--field); border-radius: 16rpx; padding: 6rpx; }
.tab { flex: 1; text-align: center; height: 62rpx; line-height: 62rpx; font-size: 26rpx; color: var(--ink-2); border-radius: 12rpx; }
.tab.on { background: #fff; color: var(--primary); font-weight: 600; }
.field { display: flex; align-items: center; height: 88rpx; background: var(--field); border-radius: 16rpx; margin-top: 16rpx; padding: 0 24rpx; }
.label { width: 110rpx; font-size: 26rpx; color: var(--ink-2); }
.input { flex: 1; font-size: 28rpx; }
.ph { color: var(--ink-3); }
.err { margin-top: 12rpx; }
.submit { margin-top: 24rpx; }
.sum-card { display: flex; align-items: center; padding: 30rpx 0; }
.sum-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum-cell text { margin-top: 8rpx; }
.divider { width: 1rpx; height: 60rpx; background: var(--line); }
.entries { padding: 0; overflow: hidden; margin-top: 18rpx; }
.entry { padding: 26rpx 30rpx; }
.base-desc { margin-top: 12rpx; line-height: 1.6; }
.base-msg { margin-top: 14rpx; }
.base-actions { margin-top: 20rpx; }
.base-save { margin-left: 20rpx; height: 76rpx; border-radius: 38rpx; font-size: 26rpx; }
.logout-wrap { margin-top: 30rpx; }
.logout {
  height: 92rpx;
  border-radius: 46rpx;
  background: #fff;
  color: var(--down);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
