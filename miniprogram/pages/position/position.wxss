.page { min-height: 100vh; background: var(--page-bg); }
.top-pad { padding-top: 18rpx; }
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: var(--field);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
}
.search-input { height: 80rpx; background: var(--field); border-radius: 40rpx; padding: 0 30rpx; font-size: 26rpx; margin-top: 16rpx; }
.ph { color: var(--ink-3); }
.results { margin-top: 10rpx; }
.result-row { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.field { display: flex; align-items: center; height: 88rpx; background: var(--field); border-radius: 16rpx; margin-top: 16rpx; padding: 0 24rpx; }
.label { width: 150rpx; font-size: 26rpx; color: var(--ink-2); }
.input { flex: 1; font-size: 28rpx; }
.note { margin-top: 16rpx; line-height: 1.6; }
.err { padding: 24rpx 30rpx; }
.list { background: #fff; margin-top: 12rpx; }
.pos-row { display: flex; align-items: center; padding: 24rpx 30rpx; }
.sub { margin-top: 6rpx; }
.act { margin-left: 16rpx; padding: 8rpx 22rpx; border-radius: 30rpx; background: var(--field); font-size: 24rpx; color: var(--ink-2); }
.act.danger { color: var(--up); }
.edit-box { padding: 0 30rpx 30rpx; }
.btn-primary.small { height: 76rpx; border-radius: 38rpx; font-size: 26rpx; margin-top: 20rpx; }
.empty-tip { padding: 60rpx 30rpx; text-align: center; }
.bottom-space { height: 60rpx; }
