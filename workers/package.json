{
  "name": "fund-watch-workers",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers 后端（D1），源码在 src/，部署用仓库根目录的 wrangler 命令",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply fund-watch --local",
    "migrate:remote": "wrangler d1 migrations apply fund-watch --remote"
  }
}
